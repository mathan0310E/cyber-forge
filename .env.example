# ---------------------------------------------------------------------------
# Wolf Forge configuration
#
# Copy to `.env` and fill in what you need. NOTHING here is required to boot the
# API: every external integration degrades to an honest "setup required" state.
# See docs/configuration.md for which variable unlocks which feature.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# --- Persistence ------------------------------------------------------------
# "auto"  -> use Firestore when Firebase credentials are present, else the
#            local filesystem dev driver (data lives in .data/).
# "firestore" -> require Firebase; fail fast if unconfigured.
# "local"  -> always use the filesystem dev driver.
WOLF_FORGE_DATA_DRIVER=auto

# --- Authentication ---------------------------------------------------------
# "auto" | "firebase" | "local"
# The local driver issues signed session tokens for development only. It is
# refused when NODE_ENV=production unless WOLF_FORGE_ALLOW_LOCAL_AUTH_IN_PROD=1.
WOLF_FORGE_AUTH_DRIVER=auto
# >=32 char secret used to sign local dev session tokens. Generate your own.
WOLF_FORGE_LOCAL_AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
WOLF_FORGE_ALLOW_LOCAL_AUTH_IN_PROD=0

# --- Firebase web client (Google sign-in) -----------------------------------
# Non-secret browser config. Required for the "Continue with Google" button.
# Enable the Google provider in Firebase Authentication, and add the app's
# origin (http://localhost:5173) to the Firebase authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase (Admin SDK, server side) --------------------------------------
# Either point at a service account JSON file, or supply the three fields below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escape newlines as \n when placing the key on a single line.
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firebase (web client, exposed to the browser; not secrets) -------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- OpenRouter (primary free-first AI provider) ----------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# When true the backend refuses to dispatch to any model whose price is not
# verified as zero. Enforced in code, not in the UI.
WOLF_FORGE_FREE_ONLY=true
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Wolf Forge
# How long to cache the OpenRouter model catalogue (ms).
OPENROUTER_CATALOG_TTL_MS=900000

# --- Gemini (optional) ------------------------------------------------------
GEMINI_API_KEY=
# Comma-separated allowlist. A Gemini model is never treated as free by default.
GEMINI_FREE_MODELS=

# --- Ollama (optional, local inference) ------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_ENABLED=false

# --- Sandbox / build worker -------------------------------------------------
SANDBOX_ENABLED=true
# "docker" | "local"
SANDBOX_DRIVER=auto
SANDBOX_IMAGE=node:20-alpine
SANDBOX_BUILD_TIMEOUT_MS=300000
SANDBOX_INSTALL_TIMEOUT_MS=300000
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
# Allow dependency installation to reach the network. Required for real builds.
SANDBOX_ALLOW_NETWORK=true
# Allow the preview container to be reachable on the host.
SANDBOX_PREVIEW_PORT_RANGE_START=4100
SANDBOX_PREVIEW_PORT_RANGE_END=4300

# --- Artifacts --------------------------------------------------------------
ARTIFACT_STORAGE_PATH=.artifacts

# --- GitHub integration -----------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL the OAuth callback resolves to (must match the GitHub App/OAuth app).
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/integrations/github/callback
# 32-byte base64 key used to encrypt integration tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# --- Vercel integration (OAuth) --------------------------------------------
# Vercel OAuth App credentials. When set, users can connect their own Vercel
# account from the post-sign-in onboarding (or from Integrations). Requires
# INTEGRATION_ENCRYPTION_KEY to encrypt each user's token at rest.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
# Public callback URL (must match the Vercel OAuth App).
VERCEL_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/integrations/vercel/callback

# --- Deployment provider (server account fallback) -------------------------
# "vercel" is the implemented provider. Empty disables deployment.
DEPLOYMENT_PROVIDER=
DEPLOYMENT_API_TOKEN=
# Optional team/project scoping for the server account token.
DEPLOYMENT_VERCEL_TEAM_ID=
DEPLOYMENT_VERCEL_PROJECT_ID=

# Comma-separated list of UIDs allowed to reach admin-only endpoints.
WOLF_FORGE_ADMIN_UIDS=

# --- Quotas (per user, adjustable) -----------------------------------------
QUOTA_MAX_CONCURRENT_BUILDS=1
QUOTA_MAX_REPAIR_ATTEMPTS=2
QUOTA_MAX_BUILD_DURATION_MS=900000
QUOTA_MAX_PROMPT_CHARS=8000
QUOTA_MAX_FILES_PER_PROJECT=120
QUOTA_MAX_SOURCE_BYTES=2000000
QUOTA_MAX_OUTPUT_TOKENS=8192
QUOTA_DAILY_BUILDS=25
QUOTA_REQUESTS_PER_MINUTE=60
