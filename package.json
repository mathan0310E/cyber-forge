{
  "name": "wolf-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Wolf Forge — Your Ideas. Our Forge. A free-first, multi-model AI website builder.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @wolf-forge/api",
    "dev:web": "npm run dev --workspace @wolf-forge/web",
    "build": "npm run build --workspace @wolf-forge/shared-types && npm run build --workspace @wolf-forge/api && npm run build --workspace @wolf-forge/web",
    "build:api": "npm run build --workspace @wolf-forge/api",
    "build:web": "npm run build --workspace @wolf-forge/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "start": "npm run start --workspace @wolf-forge/api",
    "clean": "rm -rf apps/*/dist packages/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  }
}
